# Copie este arquivo para `.env` e ajuste os valores.
# NUNCA faça commit do arquivo `.env` (ele já está no .gitignore).

# ----- Servidor -----
NODE_ENV=development
PORT=3000

# Origens que podem chamar a API (frontend React/Vite). Separe por vírgula.
CORS_ORIGINS=http://localhost:5173

# Fuso usado quando o frontend manda data/hora SEM fuso (ex.: 2026-11-10T14:00).
# Fortaleza = -03:00
FUSO_HORARIO=-03:00

# Endereço público da API (usado nos links de download dos certificados).
# Deixe vazio em desenvolvimento.
API_URL_PUBLICA=

# ----- Banco de dados (Prisma + MySQL) -----
# Formato: mysql://USUARIO:SENHA@SERVIDOR:PORTA/NOME_DO_BANCO
DATABASE_URL="mysql://portal_app:troque-esta-senha@localhost:3306/portal_atividades"

# Banco usado SOMENTE por `npm test`. Ele é APAGADO e recriado a cada execução.
# O nome do banco precisa terminar em _test.
DATABASE_URL_TEST="mysql://portal_app:troque-esta-senha@localhost:3306/portal_atividades_test"

# ----- Login de teste e identificação do usuário -----
# Decisão do grupo: sem token. O usuário é identificado pela matrícula (a mesma
# da Unifor) enviada no cabeçalho HTTP "X-Matricula". O login de teste
# (POST /api/auth/login) só confere matrícula e senha e devolve os dados do usuário.
#   cabecalho -> lê X-Matricula (PADRÃO)
#   nenhum    -> ninguém é identificado; só as rotas públicas funcionam
IDENTIFICACAO_MODO=cabecalho

# Custo do bcrypt para as senhas (10 a 14 é o recomendado).
BCRYPT_ROUNDS=12

# Permite que alunos criem a própria conta em POST /api/auth/cadastro.
CADASTRO_PUBLICO_HABILITADO=true

# Proteção contra tentativa e erro de senha: falhas permitidas por janela (minutos).
LOGIN_MAX_TENTATIVAS=5
LOGIN_JANELA_MINUTOS=15

# ----- Certificados enviados -----
# Pasta onde os arquivos ficam guardados (fora de qualquer pasta pública).
UPLOADS_DIR=uploads
# Tamanho máximo de cada arquivo, em MB.
ARQUIVO_TAMANHO_MAXIMO_MB=10
# Segredo para assinar os links de download (texto aleatório com 32+ caracteres).
# Obrigatório em produção. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ARQUIVOS_SEGREDO=
# Por quantos minutos um link de certificado continua válido.
LINK_ARQUIVO_VALIDADE_MINUTOS=60
